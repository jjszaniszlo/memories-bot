{
  "name": "memories-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/handler.mjs --external:@aws-sdk/* --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --minify-syntax --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "register": "node --env-file=.env --import tsx scripts/register-commands.ts",
    "deploy": "npm run build && terraform -chdir=terraform apply"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "discord-api-types": "^0.38.57"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-lambda": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
