# --- Discord (both deployments) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=
SCAN_CHANNEL_IDS=111111111111111111,222222222222222222
MEMORIES_CHANNEL_ID=
BOT_TIMEZONE=America/Los_Angeles
REPOST_COOLDOWN_DAYS=90
MIN_AGE_DAYS=30

# --- Long-running daemon (Raspberry Pi / Docker) ---
# STORE=sqlite and SQLITE_PATH are set by compose.yaml; 5-field cron in BOT_TIMEZONE.
REPOST_CRON=0 14 * * *
POLL_INTERVAL_MINUTES=15

